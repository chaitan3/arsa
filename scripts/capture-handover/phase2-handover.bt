#!/usr/bin/env bpftrace
/*
 * Phase 2 - put the handover on a timeline and find the readiness/completion
 * signals that Phase 1 showed are NOT DRM events.
 *
 *   sudo bpftrace scripts/capture-handover/phase2-handover.bt
 *
 * Generate visible motion (drag a window / scroll a terminal). For the GETCRTC
 * delta, run the server capture at the same time (see the note at the end).
 * Ctrl-C to stop; the histograms print on exit.
 *
 * What the maps answer:
 *
 *   @handover, @handover_us   presentation cadence, from drm_atomic_set_fb_for_plane
 *                             (one per handed-over frame; no struct deref, so it
 *                             always works - the fb id needs module BTF, added later)
 *   @atomic_ms                if this is ~0, the atomic commit is NON-blocking and
 *                             its return is not a completion signal; if it is large,
 *                             the ioctl blocks until the commit completes and its
 *                             return *is* a usable "committed" timestamp.
 *   @tl_wait_us               how long the compositor waits for the producer
 *                             (drm_syncobj_timeline_wait_ioctl); non-zero means the
 *                             frame is ready before handover for those commits.
 *   @commit_wait_us           who waits for the commit itself, and how long.
 *   @signaled[ctx]            dma_fence contexts that signal; correlate the sample
 *                             lines' ctx with the commit timeline.
 *
 * Note: the kernel has no "flip complete" event here, so completeness must come
 * from a fence (dma_fence_signaled) or from a blocking atomic ioctl return.
 */

BEGIN {
  printf("phase2: handover/readiness probe. Generate VISIBLE MOTION now.\n");
}

/* 1. handover cadence (works regardless of struct BTF) -------------------- */
kprobe:drm_atomic_set_fb_for_plane {
  @handover++;
  if (@prev_h > 0) { @handover_us = hist((nsecs - @prev_h) / 1000); }
  @prev_h = nsecs;
  if (@h_show < 10) { @h_show++; printf("handover t=%llu comm=%s\n", nsecs, comm); }
}

/* 2. is the atomic commit blocking? --------------------------------------- */
kprobe:drm_mode_atomic_ioctl    { @atomic_start[tid] = nsecs; }
kretprobe:drm_mode_atomic_ioctl /@atomic_start[tid] > 0/ {
  @atomic_ms = hist((nsecs - @atomic_start[tid]) / 1000000);
  delete(@atomic_start[tid]);
}

/* 3. producer readiness: compositor waits on the client's syncobj timeline - */
kprobe:drm_syncobj_timeline_wait_ioctl { @tl_wait++; @tl_start[tid] = nsecs; }
kretprobe:drm_syncobj_timeline_wait_ioctl /@tl_start[tid] > 0/ {
  @tl_wait_us = hist((nsecs - @tl_start[tid]) / 1000);
  delete(@tl_start[tid]);
}

/* 4. commit completion waits --------------------------------------------- */
kprobe:drm_crtc_commit_wait     { @commit_wait++; @cw_start[tid] = nsecs; }
kretprobe:drm_crtc_commit_wait /@cw_start[tid] > 0/ {
  @commit_wait_us = hist((nsecs - @cw_start[tid]) / 1000);
  delete(@cw_start[tid]);
}

/* 5. which fences signal, and when --------------------------------------- */
tracepoint:dma_fence:dma_fence_signaled {
  @signaled[args->context]++;
  if (@fs_show < 20) {
    @fs_show++;
    printf("fence    t=%llu ctx=%llu seq=%llu\n", nsecs, args->context, args->seqno);
  }
}

interval:s:2 {
  printf("t=%llu handover=%llu tl_wait=%llu commit_wait=%llu\n",
         nsecs, @handover, @tl_wait, @commit_wait);
}

/*
 * To measure the observation lag, add this probe filtered to the running
 * server's pid (replace <PID>), then compare its timestamps with `handover`:
 *
 *   kprobe:drm_mode_getcrtc /pid == <PID>/ { @obs++; printf("observe t=%llu\n", nsecs); }
 */
